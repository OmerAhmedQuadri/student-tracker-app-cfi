{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node"],
    "resolveJsonModule": true
  },

  "ts-node": {
    "transpileOnly": true
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
