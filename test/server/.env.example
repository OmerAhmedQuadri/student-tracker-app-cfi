# Server
PORT=5000
NODE_ENV=development

# Mongo
MONGO_URI=mongodb://localhost:27017/student-tracker

# Auth
JWT_SECRET=change_me

# Optional (recommended): separate secrets for access/refresh tokens.
# If unset, both fall back to JWT_SECRET.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional integrations
GITHUB_TOKEN=
